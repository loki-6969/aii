graph = {
    'A': ['B', 'C'],
    'B': ['D', 'E'],
    'C': ['F', 'G'],
    'D': [],
    'E': [],
    'F': [],
    'G': []
}

goal = 'G'
queue = ['A']

while queue:
    node = queue.pop(0)

    if node == goal:
        print("Goal Found", goal)
        break

    for child in graph[node]:
        queue.append(child)

Goal Found G
